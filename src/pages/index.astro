---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
const [settings, { entries: posts, cacheHint }, { entries: projects }] = await Promise.all([
  getSiteSettings(),
  getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 6 }),
  getEmDashCollection("projects", { orderBy: { published_at: "desc" }, limit: 3 }),
]);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---
<Base description="mori.space — 개발과 만든 것들을 기록하는 개인 포트폴리오">
  <section class="shell grid gap-12 pb-24 pt-20 sm:pb-32 sm:pt-28 lg:grid-cols-[1.2fr_.8fr] lg:items-end lg:gap-20">
    <div><p class="eyebrow">Developer · Builder · Writer</p><h1 class="mt-6 max-w-4xl text-[3.5rem] font-bold leading-[0.98] tracking-[-0.065em] sm:text-7xl lg:text-[6.5rem]">만든 것과<br /><span class="text-moss">배운 것</span>을<br class="hidden sm:block" /> 기록합니다.</h1><p class="mt-8 max-w-xl text-[1.05rem] leading-8 text-ink/65 sm:text-lg">{settings?.tagline || "서비스를 만들고, 문제를 해결하고, 그 과정을 글로 남깁니다."}</p><div class="mt-9 flex flex-wrap gap-3"><a href="/posts" class="button-primary">전체 글 보기&nbsp;↗</a><a href="/about" class="button-secondary">나는 누구인가</a></div></div>
    <div class="relative overflow-hidden rounded-[2rem] bg-moss p-7 text-paper shadow-2xl shadow-moss/15 sm:p-9"><div class="absolute -right-12 -top-12 h-40 w-40 rounded-full border border-paper/20"></div><div class="absolute -right-4 -top-4 h-24 w-24 rounded-full border border-paper/20"></div><p class="relative text-[0.7rem] font-bold uppercase tracking-[0.22em] text-paper/60">현재 만들고 있는 것</p><h2 class="relative mt-16 max-w-xs text-3xl font-bold leading-[1.05] tracking-[-0.04em]">작은 도구를 오래<br />쓸 수 있게 만들기</h2><p class="relative mt-6 max-w-sm leading-7 text-paper/70">Cloudflare Workers, D1, R2와 TypeScript를 좋아합니다. 실패와 개선의 기록도 함께 남깁니다.</p><a href="/posts?tag=development" class="focus-ring relative mt-8 inline-block text-sm font-bold underline decoration-paper/40 underline-offset-4 hover:text-paper/75">개발 글 둘러보기&nbsp;↗</a></div>
  </section>
  <section class="shell pb-24"><div class="section-rule mb-8"><div><p class="eyebrow">Latest notes</p><h2 class="mt-2 text-2xl font-bold tracking-tight">최근 기술 글</h2></div><a href="/posts" class="focus-ring text-sm font-bold text-moss hover:text-ink">모두 보기&nbsp;↗</a></div><div class="grid gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">{posts.slice(0, 3).map((post) => <PostCard post={post} />)}</div></section>
  <section class="shell pb-24"><div class="section-rule mb-8"><div><p class="eyebrow">Selected work</p><h2 class="mt-2 text-2xl font-bold tracking-tight">작업물</h2></div><a href="/projects" class="focus-ring text-sm font-bold text-moss hover:text-ink">전체 작업물&nbsp;↗</a></div><div class="grid gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">{projects.map((project) => <PostCard post={project} kind="project" href={`/projects/${project.id}`} />)}</div></section>
</Base>

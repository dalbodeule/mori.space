---
import { Image } from "emdash/ui";
interface Props { post: any; href?: string; kind?: "post" | "project"; }
const { post, href = `/posts/${post.id}`, kind = "post" } = Astro.props;
const image = post.data.featured_image;
const postType = kind === "project" ? "작업물" : "기술 글";
---
<article class="group flex h-full flex-col border-t border-ink/20 pt-4">
  {image && <a href={href} class="focus-ring mb-5 block overflow-hidden rounded-2xl bg-moss/10"><Image image={image} class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-[1.03]" /></a>}
  <div class="flex flex-1 flex-col">
    <div class="mb-3 flex items-center gap-3 text-[0.7rem] font-bold uppercase tracking-[0.16em] text-ink/45"><span>{postType}</span>{post.data.year && <span>· {post.data.year}</span>}</div>
    <h2 class="text-[1.35rem] font-bold leading-snug tracking-[-0.025em]"><a href={href} class="focus-ring rounded-sm hover:text-moss">{post.data.title}</a></h2>
    {post.data.summary && <p class="mt-3 line-clamp-3 text-[0.95rem] leading-7 text-ink/60">{post.data.summary}</p>}
    <a href={href} class="focus-ring mt-auto pt-6 text-sm font-bold text-moss hover:text-ink">자세히 읽기&nbsp;↗</a>
  </div>
</article>

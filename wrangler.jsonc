{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mori-space",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mori-space",
      "database_id": "844091f4-36dc-4933-b4fa-2744381c6499",
      "migrations_dir": "../../migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "mori-space-media",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "0f71745735e84428a04bc05de1953473",
    },
  ],
  "vars": {
    "SITE_URL": "https://mori.space",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
}
